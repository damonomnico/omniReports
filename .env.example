# ---- Core ---------------------------------------------------------------
# Postgres connection string. Adding Neon through Vercel Storage sets this
# (the pooled URL) and DATABASE_URL_UNPOOLED (used for schema migrations).
DATABASE_URL=postgres://omni:omni@localhost:5432/omnireports

# Public URL of the app, no trailing slash. Used for invite links, Google
# OAuth redirects and the DataForSEO postback webhook.
APP_URL=http://localhost:3000

# 64 hex chars. Encrypts stored Google tokens and signs OAuth state.
# Generate with: openssl rand -hex 32
# Changing it later invalidates every stored Google connection.
APP_SECRET=

# Protects the scheduled job endpoints. Vercel sends it automatically as
# "Authorization: Bearer <CRON_SECRET>". It is also the one-time setup key
# asked for at /setup when creating the first admin login.
# Generate with: openssl rand -hex 24
CRON_SECRET=

# ---- DataForSEO (rank tracker) -----------------------------------------
# API login + password from https://app.dataforseo.com/api-access
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Leave unset for production. Set to https://sandbox.dataforseo.com to test
# for free against dummy data.
DATAFORSEO_BASE_URL=

# ---- Google (Search Console, Analytics, Business Profile) ---------------
# OAuth client (type "Web application") from Google Cloud Console.
# Authorised redirect URI: <APP_URL>/api/google/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Email (invites, password resets, scheduled reports) ----------------
# Without a key, emails are logged to the server console instead of sent and
# staff can copy invite links from the UI.
RESEND_API_KEY=
EMAIL_FROM="omniReports <reports@example.com>"
